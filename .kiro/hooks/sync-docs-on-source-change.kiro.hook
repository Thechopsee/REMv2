{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "When C++ source files, headers, or key config files are edited, ask the agent to update the README or any docs to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.cpp",
      "src/**/*.hh",
      "include/**/*.hh",
      "platformio.ini",
      "wokwi.toml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and update the documentation accordingly — check the README.md first, and if there is a /docs folder, update relevant files there too. Focus on sections that describe the changed functionality, architecture, configuration, or usage. Only update docs if the change meaningfully affects what is documented; skip trivial edits like formatting or comments."
  }
}